{
  "name": "zelda-oot-js",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "pages:build": "vite build --config vite.config.ts --mode pages",
    "pages:deploy": "tsx tools/pages/deploy.ts",
    "dev": "vite --config vite.config.ts",
    "analyze": "tsx tools/analyze/cli.ts",
    "analyze:setup": "node tools/analyze/setup.mjs",
    "rom:extract": "tsx tools/rom/cli.ts extract",
    "recomp": "tsx tools/recomp/cli.ts",
    "port": "tsx tools/port/cli.ts",
    "headless": "tsx tools/headless/cli.ts",
    "sweep": "tsx tools/sweep/cli.ts",
    "save": "tsx tools/saves/cli.ts",
    "tex": "tsx tools/tex/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "preact": "^11.0.1"
  }
}
